{
  "name": "ultra-vision",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first browser vision and gesture-controlled two-deck DJ mixing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaantaskentt/ultra-vision.git"
  },
  "homepage": "https://ultra-vision.vercel.app",
  "bugs": {
    "url": "https://github.com/kaantaskentt/ultra-vision/issues"
  },
  "keywords": [
    "computer-vision",
    "gesture-control",
    "local-first",
    "mediapipe",
    "web-audio",
    "dj"
  ],
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run test:coverage && npm run lint && npm run build && npm audit --audit-level=high",
    "lint": "oxlint --deny-warnings --ignore-pattern \"public/vendor/**\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "28.1.0",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
